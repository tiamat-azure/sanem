# Copy this file to .env and fill in real values. Never commit .env.

# Shared password required to access Sanem.
#
# WARNING - v3 threat model. In v2, Sanem only received files: the worst case
# for whoever guessed the password was dropping unwanted files. From v3 on,
# anyone who knows the shared password can read and download every file that
# has been uploaded, including files uploaded by others. The password is no
# longer just a write authorization: it is the only protection in read access
# for the entire content. This risk is known and accepted for this POC. The
# 5-character minimum is kept and the Lukluk (watch) mode is not restricted
# behind an extra condition. The rate limiting on /api/login stays the only
# real safeguard, and relaxing it becomes all the more unacceptable. The
# project owner is responsible for choosing a password worthy of what it
# exposes, not the technical minimum allowed by src/config.js.
SANEM_PASSWORD=change-me

# Secret used to sign session cookies. Minimum 32 characters. Generate one
# with: openssl rand -base64 48
SANEM_SESSION_SECRET=change-me-to-a-random-string-at-least-32-characters-long

# Local port the container listens on (also the host port via docker-compose).
SANEM_PORT=3900

# Hours after which an incomplete upload is considered orphaned and cleaned up.
SANEM_TMP_TTL_HOURS=48

# Maximum accepted file size, in gigabytes (enforced client- and server-side).
SANEM_MAX_FILE_GB=20

# Maximum size of the transcode/ HLS segment cache, in gigabytes. Beyond it,
# least-recently-read segments are purged (LRU).
SANEM_TRANSCODE_CACHE_GB=20

# Maximum number of concurrent ffmpeg processes. Do not raise without reason:
# uploads remain the primary function of the service (PRD §10).
SANEM_FFMPEG_CONCURRENCY=1

# libx264 preset used by transcode path 3 (re-encode). Accepted values: the
# standard x264 presets (ultrafast .. placebo).
SANEM_X264_PRESET=veryfast
